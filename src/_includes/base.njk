<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
{% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Jost:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/tokens.css">
<link rel="stylesheet" href="/assets/css/site.css">
<script>document.documentElement.classList.add('js')</script>
{% block head %}{% endblock %}
</head>
<body>
{% include "nav.njk" %}
<main>
{% block content %}{% endblock %}
</main>
{% include "footer.njk" %}
<script src="/download.js" defer></script>
<script src="/assets/js/nav.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
